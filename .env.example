VIRUSTOTAL_API_KEY=

# Comma-separated list of browser origins allowed to call the API directly.
# Keep this explicit in production.
TAFUST_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173

# Optional regex for advanced cases. Leave empty unless you really need it.
TAFUST_ALLOWED_ORIGIN_REGEX=

# Hosts accepted by the API itself.
TAFUST_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to true only when the API is behind HTTPS in production.
TAFUST_FORCE_HTTPS=false
